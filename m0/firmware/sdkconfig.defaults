# Slate M0 — build configuration.
#
# Kept as small as it can be: everything here is either required to boot the
# Tab5's panel or required by a v0.1 question. The kept tree at v1.1 starts its
# own config rather than inheriting this one.

CONFIG_IDF_TARGET="esp32p4"

# Silicon revision. The Tab5 on this desk reports ESP32-P4 v1.3, and ESP-IDF
# treats P4 revisions <3.0 and >=3.0 as **mutually exclusive** build targets —
# "huge hardware difference", in its own Kconfig. IDF 5.5's default is v3.1, so
# without these two lines the bootloader refuses to flash this board:
#
#   bootloader.bin requires chip revision in range [v3.1 - v3.99]
#   (this chip is revision v1.3)
#
# A binary built this way runs on 0.x/1.x boards and NOT on 3.x ones. If a
# second Tab5 with 3.x silicon ever appears, it needs its own build, not a
# tweak to this one — which is exactly why v0.1 records the revision.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# The P4 runs from PSRAM-backed framebuffers at 1280x720; the defaults are far
# too small for a display this size.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y

# LVGL's own task and the BSP's port task both want stack; the default main task
# stack is not enough once a widget tree is being built.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Log at INFO so the panel-revision probe and the LVGL measurements are visible
# over `idf.py monitor` without a rebuild.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# USB-Serial-JTAG is the console: the Tab5 exposes exactly one data port and it
# is the same one used to flash.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Flash: 16 MB on the Tab5.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# A custom table rather than SINGLE_APP_LARGE: the two stock Montserrat faces
# alone take the binary to within 3% of that layout's 1.5 MB app partition. See
# partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The whole reason v0.1 exists: LVGL's runtime XML loader, and with it the
# vendored expat. LVGL carried this at 9.3/9.4 and removed it at 9.5, which is
# why main/idf_component.yml pins 9.4.0.
CONFIG_LV_USE_XML=y

# Required by LV_USE_XML ("LV_USE_OBJ_NAME is required to use XMLs"), and wanted
# on its own account: lv_obj_find_by_name() is exactly the lookup the applicator
# needs to turn a data update's `id` into a widget. The two halves of Slate's
# page model — named elements in XML, targeted updates by name — rest on it.
CONFIG_LV_USE_OBJ_NAME=y

# Two extra stock sizes, and only two. M0 has no type ladder — the size roles
# and both real faces arrive with the token layer at v1.3. 48 is the counter's
# "~80 px" from the brief at the nearest stock size; 24 makes doc-view headings
# "merely larger" without inventing a hierarchy.
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# SDIO до ESP32-C6 — піни саме Tab5, а не eval-плати P4.
#
# Тут і був блокер мережі. esp_hosted за замовчуванням описує ESP32-P4 Function
# EV Board (CLK 18, CMD 19, D0-D3 14-17, reset 54), а на Tab5 C6 підвішений
# зовсім інакше. З чужими пінами `send_op_cond` просто спливає за таймаутом, і
# це виглядає як "на C6 немає прошивки" — хоча заводська SDIO-прошибка там є, і
# просто ніхто не стукав у правильні ноги.
# Задавати треба саме PRIV_..._SLOT_1: видимі ESP_HOSTED_SDIO_PIN_* лише
# обчислюються з них через `default ... if SLOT_1` і мовчки ігнорують пряме
# присвоєння.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
# ESPHome для Tab5 задає reset як active_high; форумна порада про active_low
# помилкова і лишає C6 у скиданні назавжди.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
