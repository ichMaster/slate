# Copy to sdkconfig.defaults.local and fill in. That file is gitignored.
#
# ARCHITECTURE.md §Security allows WiFi credentials and the server address to
# live in firmware — they are the only secrets that may — but this repository is
# public, so the real values never get committed.

CONFIG_SLATE_WIFI_SSID="your-network"
CONFIG_SLATE_WIFI_PASSWORD="your-password"

# The deployment server (ARCHITECTURE.md §Deployment and test topology).
CONFIG_SLATE_SERVER_HOST="192.168.1.197"
CONFIG_SLATE_SERVER_PORT=8000
