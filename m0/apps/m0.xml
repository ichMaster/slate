<!--
  Slate M0 — the walking skeleton's only page.

  Deliberately crude (ui-m0-brief.md, ui-implementation.md §6): raw LVGL widgets,
  stock theme, default font, no components, no tokens, no chrome. If this file
  starts looking designed, the milestone has drifted.

  Three names are load-bearing — the applicator finds widgets by them:
    count  the number that lives on the server   (text)
    clock  the 1 Hz unsolicited push             (text)
    doc    the doc-view v0 block column          (items)

  SLATE-002 verifies this parses and instantiates under lv_xml on the ESP32-P4;
  that verdict is the reason v0.1 exists. The layout uses flex only — no pixel
  coordinates anywhere, which is a rule that outlives M0.
-->
<component>
  <view extends="lv_obj"
        width="100%" height="100%"
        style_bg_color="0xe0e0e0"
        style_border_width="0"
        style_pad_all="16"
        flex_flow="column"
        style_flex_main_place="start"
        style_flex_cross_place="center">

    <lv_label name="title" text="Slate M0"/>

    <lv_obj name="counter_row"
            width="100%" height="content"
            style_bg_opa="0"
            style_border_width="0"
            style_pad_all="0"
            flex_flow="row"
            style_flex_main_place="center"
            style_flex_cross_place="center">
      <lv_label name="count" text="0" style_text_font="lv_font_montserrat_48"/>
      <lv_button name="increment_btn" width="content" height="content">
        <lv_label text="+1"/>
      </lv_button>
    </lv_obj>

    <lv_label name="clock" text="--:--:--"/>

    <lv_obj name="doc"
            width="100%" height="55%"
            style_bg_color="0xffffff"
            style_pad_all="12"
            flex_flow="column"
            style_flex_main_place="start"
            style_flex_cross_place="start"/>

  </view>
</component>
